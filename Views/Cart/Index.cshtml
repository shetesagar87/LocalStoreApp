@model IEnumerable<CleanMvcApp.Models.Entities.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
    var subtotal = ViewBag.Subtotal as decimal? ?? 0;
}

<div class="container mt-4">
    <h2 class="mb-4">
        <i class="bi bi-cart"></i> Shopping Cart
    </h2>

    @if (Model != null && Model.Any())
    {
        var itemsByStore = Model.GroupBy(item => item.Product.StoreId).ToList();

        <div class="row">
            <!-- Cart Items -->
            <div class="col-md-8">
                @foreach (var storeGroup in itemsByStore)
                {
                    var storeItems = storeGroup.ToList();
                    var firstItem = storeItems.First();
                    var storeName = firstItem.Product.Store?.StoreName ?? "Unknown Store";
                    var storeId = storeGroup.Key;
                    
                    decimal storeSubtotal = 0;
                    foreach (var item in storeItems)
                    {
                        var discountedPrice = item.Product.Price * (1 - item.Product.DiscountPercentage / 100);
                        storeSubtotal += discountedPrice * item.Quantity;
                    }

                    <div class="card mb-3">
                        <div class="card-header bg-light">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <i class="bi bi-shop"></i> @storeName
                                </h5>
                                <a asp-controller="Checkout" asp-action="Index" asp-route-storeId="@storeId" class="btn btn-primary btn-sm">
                                    <i class="bi bi-credit-card"></i> Checkout Store
                                </a>
                            </div>
                        </div>
                        <div class="card-body">
                            @foreach (var item in storeItems)
                            {
                                var product = item.Product;
                                var discountedPrice = product.Price * (1 - product.DiscountPercentage / 100);
                                var itemSubtotal = discountedPrice * item.Quantity;
                                
                                <div class="row cart-item mb-3 pb-3 border-bottom" data-cart-item-id="@item.CartItemId">
                                    <div class="col-md-2">
                                        @if (!string.IsNullOrEmpty(product.ProductImageUrl))
                                        {
                                            <img src="@product.ProductImageUrl" class="img-fluid rounded" alt="@product.ProductName">
                                        }
                                        else
                                        {
                                            <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height: 80px;">
                                                <i class="bi bi-box" style="font-size: 2rem; color: #ccc;"></i>
                                            </div>
                                        }
                                    </div>
                                    <div class="col-md-4">
                                        <h6>@product.ProductName</h6>
                                        <p class="text-muted small mb-1">SKU: @product.SKU</p>
                                        @if (product.DiscountPercentage > 0)
                                        {
                                            <span class="badge bg-danger">@product.DiscountPercentage% OFF</span>
                                        }
                                    </div>
                                    <div class="col-md-2">
                                        @if (product.DiscountPercentage > 0)
                                        {
                                            <p class="mb-0">
                                                <span class="text-decoration-line-through text-muted small">₹@product.Price</span>
                                            </p>
                                            <p class="fw-bold text-success mb-0">₹@discountedPrice.ToString("F2")</p>
                                        }
                                        else
                                        {
                                            <p class="fw-bold mb-0">₹@product.Price</p>
                                        }
                                    </div>
                                    <div class="col-md-2">
                                        <div class="input-group input-group-sm">
                                            <button class="btn btn-outline-secondary" type="button" onclick="updateQuantity(@item.CartItemId, @(item.Quantity - 1))">
                                                <i class="bi bi-dash"></i>
                                            </button>
                                            <input type="number" class="form-control text-center quantity-input" value="@item.Quantity" min="1" max="@product.StockQuantity" readonly>
                                            <button class="btn btn-outline-secondary" type="button" onclick="updateQuantity(@item.CartItemId, @(item.Quantity + 1))">
                                                <i class="bi bi-plus"></i>
                                            </button>
                                        </div>
                                        <small class="text-muted">Max: @product.StockQuantity</small>
                                    </div>
                                    <div class="col-md-2 text-end">
                                        <p class="fw-bold mb-2 item-subtotal">₹@itemSubtotal.ToString("F2")</p>
                                        <button class="btn btn-sm btn-outline-danger" onclick="removeItem(@item.CartItemId)">
                                            <i class="bi bi-trash"></i> Remove
                                        </button>
                                    </div>
                                </div>
                            }
                            <div class="text-end">
                                <strong>Store Subtotal: ₹@storeSubtotal.ToString("F2")</strong>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Cart Summary -->
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Cart Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Total Items:</span>
                            <span class="fw-bold">@Model.Sum(i => i.Quantity)</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal:</span>
                            <span class="fw-bold" id="cart-subtotal">₹@subtotal.ToString("F2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Delivery:</span>
                            <span class="text-muted">Per store at checkout</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="fw-bold">Total:</span>
                            <span class="fw-bold text-success" id="cart-total">₹@subtotal.ToString("F2")</span>
                        </div>
                        <div class="d-grid gap-2">
                            <a asp-controller="Browse" asp-action="Search" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Continue Shopping
                            </a>
                            <button class="btn btn-outline-danger" onclick="clearCart()">
                                <i class="bi bi-trash"></i> Clear Cart
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Cart Info -->
                <div class="card mt-3">
                    <div class="card-body">
                        <h6 class="card-title">
                            <i class="bi bi-info-circle"></i> Cart Information
                        </h6>
                        <ul class="small mb-0">
                            <li>Checkout each store separately</li>
                            <li>Items are reserved for 30 minutes</li>
                            <li>Delivery charges vary by store</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x" style="font-size: 5rem; color: #ccc;"></i>
            <h3 class="mt-3">Your cart is empty</h3>
            <p class="text-muted">Add some products to get started!</p>
            <a asp-controller="Browse" asp-action="Search" class="btn btn-primary">
                <i class="bi bi-search"></i> Browse Products
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        function updateQuantity(cartItemId, newQuantity) {
            if (newQuantity < 1) {
                alert('Quantity must be at least 1');
                return;
            }

            $.ajax({
                url: '@Url.Action("UpdateQuantity", "Cart")',
                type: 'POST',
                data: { cartItemId: cartItemId, quantity: newQuantity },
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                },
                error: function() {
                    alert('An error occurred while updating quantity.');
                }
            });
        }

        function removeItem(cartItemId) {
            if (!confirm('Are you sure you want to remove this item?')) {
                return;
            }

            $.ajax({
                url: '@Url.Action("RemoveItem", "Cart")',
                type: 'POST',
                data: { cartItemId: cartItemId },
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                },
                error: function() {
                    alert('An error occurred while removing item.');
                }
            });
        }

        function clearCart() {
            if (!confirm('Are you sure you want to clear your cart?')) {
                return;
            }

            $.ajax({
                url: '@Url.Action("Clear", "Cart")',
                type: 'POST',
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert(response.message);
                    }
                },
                error: function() {
                    alert('An error occurred while clearing cart.');
                }
            });
        }
    </script>
}
