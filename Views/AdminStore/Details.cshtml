@model CleanMvcApp.Models.Entities.Store
@{
    ViewData["Title"] = "Store Details";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Store Details</h2>
        <div>
            @if (Model.Status == CleanMvcApp.Models.Enums.StoreStatus.Pending)
            {
                <form asp-action="Approve" asp-route-id="@Model.StoreId" method="post" class="d-inline">
                    <button type="submit" class="btn btn-success" onclick="return confirm('Are you sure you want to approve this store?');">
                        Approve Store
                    </button>
                </form>
                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal">
                    Reject Store
                </button>
            }
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-4">
            @if (!string.IsNullOrEmpty(Model.StoreImageUrl))
            {
                <img src="@Model.StoreImageUrl" class="img-fluid rounded" alt="@Model.StoreName" />
            }
            else
            {
                <div class="bg-secondary text-white d-flex align-items-center justify-content-center rounded" style="height: 300px;">
                    <span>No Image</span>
                </div>
            }
        </div>
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <h3 class="card-title">@Model.StoreName</h3>
                    <hr />
                    <dl class="row">
                        <dt class="col-sm-4">Owner</dt>
                        <dd class="col-sm-8">@Model.Owner?.Email</dd>

                        <dt class="col-sm-4">Address</dt>
                        <dd class="col-sm-8">@Model.Address</dd>

                        <dt class="col-sm-4">Coordinates</dt>
                        <dd class="col-sm-8">@Model.Latitude, @Model.Longitude</dd>

                        <dt class="col-sm-4">License Number</dt>
                        <dd class="col-sm-8">@Model.LicenseNumber</dd>

                        <dt class="col-sm-4">Delivery Radius</dt>
                        <dd class="col-sm-8">@Model.DeliveryRadius km</dd>

                        <dt class="col-sm-4">Delivery Charge</dt>
                        <dd class="col-sm-8">$@Model.DeliveryCharge</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            <span class="badge @(Model.Status == CleanMvcApp.Models.Enums.StoreStatus.Approved ? "bg-success" : Model.Status == CleanMvcApp.Models.Enums.StoreStatus.Pending ? "bg-warning" : "bg-danger")">
                                @Model.Status
                            </span>
                        </dd>

                        <dt class="col-sm-4">Active</dt>
                        <dd class="col-sm-8">
                            <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                                @(Model.IsActive ? "Active" : "Inactive")
                            </span>
                        </dd>

                        <dt class="col-sm-4">Average Rating</dt>
                        <dd class="col-sm-8">@Model.AverageRating.ToString("F1") (@Model.TotalReviews reviews)</dd>

                        <dt class="col-sm-4">Created</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>

                        <dt class="col-sm-4">Last Updated</dt>
                        <dd class="col-sm-8">@Model.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Reject" asp-route-id="@Model.StoreId" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="rejectModalLabel">Reject Store</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to reject <strong>@Model.StoreName</strong>?</p>
                    <div class="mb-3">
                        <label for="reason" class="form-label">Reason for rejection:</label>
                        <textarea name="reason" class="form-control" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Reject Store</button>
                </div>
            </form>
        </div>
    </div>
</div>
