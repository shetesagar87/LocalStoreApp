@model IEnumerable<CleanMvcApp.Models.Entities.Store>
@{
    ViewData["Title"] = "Pending Store Approvals";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Pending Store Approvals</h2>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-list"></i> All Stores
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <p>No pending store approvals.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var store in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        @if (!string.IsNullOrEmpty(store.StoreImageUrl))
                        {
                            <img src="@store.StoreImageUrl" class="card-img-top" alt="@store.StoreName" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                                <span class="text-white">No Image</span>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@store.StoreName</h5>
                            <p class="card-text">
                                <strong>Owner:</strong> @store.Owner?.Email<br />
                                <strong>Address:</strong> @store.Address<br />
                                <strong>License:</strong> @store.LicenseNumber<br />
                                <strong>Delivery Radius:</strong> @store.DeliveryRadius km<br />
                                <strong>Delivery Charge:</strong> $@store.DeliveryCharge<br />
                                <strong>Submitted:</strong> @store.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                            </p>
                        </div>
                        <div class="card-footer">
                            <a asp-action="Details" asp-route-id="@store.StoreId" class="btn btn-sm btn-info">View Details</a>
                            <form asp-action="Approve" asp-route-id="@store.StoreId" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Are you sure you want to approve this store?');">
                                    Approve
                                </button>
                            </form>
                            <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal@(store.StoreId)">
                                Reject
                            </button>
                        </div>
                    </div>

                    <!-- Reject Modal -->
                    <div class="modal fade" id="rejectModal@(store.StoreId)" tabindex="-1" aria-labelledby="rejectModalLabel@(store.StoreId)" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form asp-action="Reject" asp-route-id="@store.StoreId" method="post">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="rejectModalLabel@(store.StoreId)">Reject Store</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p>Are you sure you want to reject <strong>@store.StoreName</strong>?</p>
                                        <div class="mb-3">
                                            <label for="reason" class="form-label">Reason for rejection:</label>
                                            <textarea name="reason" class="form-control" rows="3" required></textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-danger">Reject Store</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
