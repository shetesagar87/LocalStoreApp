@model CleanMvcApp.Models.Entities.Order

@{
    ViewData["Title"] = "Order Details";
    var statusClass = Model.Status switch
    {
        CleanMvcApp.Models.Enums.OrderStatus.Pending => "warning",
        CleanMvcApp.Models.Enums.OrderStatus.Accepted => "info",
        CleanMvcApp.Models.Enums.OrderStatus.Preparing => "secondary",
        CleanMvcApp.Models.Enums.OrderStatus.OutForDelivery => "primary",
        CleanMvcApp.Models.Enums.OrderStatus.Delivered => "success",
        CleanMvcApp.Models.Enums.OrderStatus.Cancelled => "danger",
        CleanMvcApp.Models.Enums.OrderStatus.Refunded => "dark",
        _ => "secondary"
    };
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="bi bi-receipt"></i> Order Details
        </h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Orders
        </a>
    </div>

    <div class="row">
        <!-- Order Information -->
        <div class="col-md-8">
            <div class="card mb-3">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Order Information</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-2">
                        <div class="col-md-4"><strong>Order Number:</strong></div>
                        <div class="col-md-8">@Model.OrderNumber</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-4"><strong>Order Date:</strong></div>
                        <div class="col-md-8">@Model.CreatedAt.ToString("MMMM dd, yyyy hh:mm tt")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-4"><strong>Status:</strong></div>
                        <div class="col-md-8">
                            <span class="badge bg-@statusClass">@Model.Status</span>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-4"><strong>Customer Email:</strong></div>
                        <div class="col-md-8">@Model.Customer?.Email</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-4"><strong>Delivery Address:</strong></div>
                        <div class="col-md-8">@Model.DeliveryAddress</div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.RejectionReason))
                    {
                        <div class="row mb-2">
                            <div class="col-md-4"><strong>Rejection Reason:</strong></div>
                            <div class="col-md-8 text-danger">@Model.RejectionReason</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Order Items -->
            <div class="card mb-3">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Order Items</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Quantity</th>
                                    <th>Unit Price</th>
                                    <th>Discount</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td>@item.ProductName</td>
                                        <td>@item.Quantity</td>
                                        <td>₹@item.UnitPrice.ToString("F2")</td>
                                        <td>@item.DiscountPercentage%</td>
                                        <td>₹@item.LineTotal.ToString("F2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Actions -->
        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Order Summary</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal:</span>
                        <span>₹@Model.SubTotal.ToString("F2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Delivery Charge:</span>
                        <span>₹@Model.DeliveryCharge.ToString("F2")</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-3">
                        <strong>Total Amount:</strong>
                        <strong class="text-success">₹@Model.TotalAmount.ToString("F2")</strong>
                    </div>
                </div>
            </div>

            <!-- Order Actions Card -->
            <div class="card mb-3">
                <div class="card-header bg-light">
                    <h6 class="mb-0">Order Actions</h6>
                </div>
                <div class="card-body">
                    @if (Model.Status == CleanMvcApp.Models.Enums.OrderStatus.Pending)
                    {
                        <form asp-action="Accept" asp-route-id="@Model.OrderId" method="post" class="mb-2">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success w-100">
                                <i class="bi bi-check-circle"></i> Accept Order
                            </button>
                        </form>

                        <button type="button" class="btn btn-danger w-100" data-bs-toggle="modal" data-bs-target="#rejectModal">
                            <i class="bi bi-x-circle"></i> Reject Order
                        </button>
                    }
                    else if (Model.Status == CleanMvcApp.Models.Enums.OrderStatus.Accepted)
                    {
                        <form asp-action="UpdateStatus" asp-route-id="@Model.OrderId" method="post" class="mb-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="status" value="Preparing" />
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-hourglass-split"></i> Mark as Preparing
                            </button>
                        </form>
                    }
                    else if (Model.Status == CleanMvcApp.Models.Enums.OrderStatus.Preparing)
                    {
                        <form asp-action="UpdateStatus" asp-route-id="@Model.OrderId" method="post" class="mb-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="status" value="OutForDelivery" />
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-truck"></i> Mark as Out for Delivery
                            </button>
                        </form>
                    }
                    else if (Model.Status == CleanMvcApp.Models.Enums.OrderStatus.OutForDelivery)
                    {
                        <form asp-action="UpdateStatus" asp-route-id="@Model.OrderId" method="post" class="mb-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="status" value="Delivered" />
                            <button type="submit" class="btn btn-success w-100">
                                <i class="bi bi-check2-all"></i> Mark as Delivered
                            </button>
                        </form>
                    }
                    else
                    {
                        <p class="text-muted text-center mb-0">No actions available for this order status.</p>
                    }
                </div>
            </div>

            <!-- Payment Information -->
            @if (Model.Payment != null)
            {
                <div class="card">
                    <div class="card-header bg-light">
                        <h6 class="mb-0">Payment Information</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            <strong>Method:</strong> @Model.Payment.PaymentMethod
                        </div>
                        <div class="mb-2">
                            <strong>Status:</strong>
                            <span class="badge bg-@(Model.Payment.Status == CleanMvcApp.Models.Enums.PaymentStatus.Completed ? "success" : "warning")">
                                @Model.Payment.Status
                            </span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Payment.TransactionId))
                        {
                            <div class="mb-2">
                                <strong>Transaction ID:</strong> @Model.Payment.TransactionId
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Reject Order Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Reject" asp-route-id="@Model.OrderId" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Reject Order</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="reason" class="form-label">Reason for Rejection <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="reason" name="reason" rows="3" required></textarea>
                        <div class="form-text">Please provide a clear reason for rejecting this order.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Reject Order</button>
                </div>
            </form>
        </div>
    </div>
</div>
