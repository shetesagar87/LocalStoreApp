@model IEnumerable<CleanMvcApp.Models.Entities.Product>

@{
    ViewData["Title"] = "Search Products";
    var categories = ViewBag.Categories as IEnumerable<CleanMvcApp.Models.Entities.Category>;
}

<div class="container mt-4">
    <h2 class="mb-4">Search Products</h2>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" id="searchForm">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Search</label>
                        <input type="text" name="searchTerm" class="form-control" placeholder="Product name..." value="@ViewBag.SearchTerm">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Category</label>
                        <select name="categoryId" class="form-select">
                            <option value="">All Categories</option>
                            @if (categories != null)
                            {
                                @foreach (var category in categories)
                                {
                                    <option value="@category.CategoryId" selected="@(ViewBag.CategoryId == category.CategoryId)">
                                        @category.CategoryName
                                    </option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Min Price</label>
                        <input type="number" name="minPrice" class="form-control" placeholder="0" step="0.01" value="@ViewBag.MinPrice">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Max Price</label>
                        <input type="number" name="maxPrice" class="form-control" placeholder="10000" step="0.01" value="@ViewBag.MaxPrice">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Min Rating</label>
                        <select name="minRating" class="form-select">
                            <option value="">Any Rating</option>
                            <option value="4" selected="@(ViewBag.MinRating == 4)">4+ Stars</option>
                            <option value="3" selected="@(ViewBag.MinRating == 3)">3+ Stars</option>
                            <option value="2" selected="@(ViewBag.MinRating == 2)">2+ Stars</option>
                        </select>
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Results -->
    <div class="row">
        <div class="col-12">
            <h4 class="mb-3">Results (@Model.Count())</h4>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var product in Model)
            {
                var discountedPrice = product.Price * (1 - product.DiscountPercentage / 100);
                
                <div class="col-md-3 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(product.ProductImageUrl))
                        {
                            <img src="@product.ProductImageUrl" class="card-img-top" alt="@product.ProductName" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="bi bi-box" style="font-size: 3rem; color: #ccc;"></i>
                            </div>
                        }
                        
                        @if (product.DiscountPercentage > 0)
                        {
                            <div class="position-absolute top-0 end-0 m-2">
                                <span class="badge bg-danger">@product.DiscountPercentage% OFF</span>
                            </div>
                        }
                        
                        <div class="card-body">
                            <h6 class="card-title">@product.ProductName</h6>
                            <p class="card-text text-muted small">
                                @if (!string.IsNullOrEmpty(product.Description) && product.Description.Length > 60)
                                {
                                    @(product.Description.Substring(0, 60) + "...")
                                }
                                else
                                {
                                    @product.Description
                                }
                            </p>
                            
                            <div class="mb-2">
                                @if (product.DiscountPercentage > 0)
                                {
                                    <span class="text-decoration-line-through text-muted">₹@product.Price</span>
                                    <span class="fw-bold text-success ms-2">₹@discountedPrice.ToString("F2")</span>
                                }
                                else
                                {
                                    <span class="fw-bold">₹@product.Price</span>
                                }
                            </div>
                            
                            <div class="mb-2">
                                @if (product.AverageRating > 0)
                                {
                                    <span class="text-warning small">
                                        @for (int i = 0; i < (int)product.AverageRating; i++)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        @for (int i = (int)product.AverageRating; i < 5; i++)
                                        {
                                            <i class="bi bi-star"></i>
                                        }
                                    </span>
                                    <span class="text-muted small">(@product.TotalReviews)</span>
                                }
                            </div>
                            
                            <div class="mb-2">
                                @if (product.StockQuantity > 0)
                                {
                                    <small class="text-success">
                                        <i class="bi bi-check-circle"></i> In Stock (@product.StockQuantity)
                                    </small>
                                }
                                else
                                {
                                    <small class="text-danger">
                                        <i class="bi bi-x-circle"></i> Out of Stock
                                    </small>
                                }
                            </div>
                        </div>
                        
                        <div class="card-footer bg-white">
                            <div class="d-grid gap-2">
                                <a asp-controller="Browse" asp-action="Details" asp-route-id="@product.ProductId" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-eye"></i> View Details
                                </a>
                                @if (product.StockQuantity > 0)
                                {
                                    <button class="btn btn-primary btn-sm" onclick="addToCart(@product.ProductId)">
                                        <i class="bi bi-cart-plus"></i> Add to Cart
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-secondary btn-sm" disabled>
                                        Out of Stock
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            <h4>No products found</h4>
            <p>Try adjusting your search criteria.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        function addToCart(productId) {
            $.ajax({
                url: '@Url.Action("AddToCart", "Cart")',
                type: 'POST',
                data: { productId: productId, quantity: 1 },
                success: function(response) {
                    if (response.success) {
                        alert(response.message);
                        updateCartBadge(response.itemCount);
                    } else {
                        alert(response.message);
                    }
                },
                error: function() {
                    alert('An error occurred while adding item to cart.');
                }
            });
        }

        function updateCartBadge(count) {
            // Update cart badge if it exists
            var badge = document.getElementById('cart-badge');
            if (badge) {
                badge.textContent = count;
            }
        }
    </script>
}
