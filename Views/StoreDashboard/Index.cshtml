@{
    ViewData["Title"] = "Store Dashboard";
    var store = ViewBag.Store as CleanMvcApp.Models.Entities.Store;
    var dailySales = ViewBag.DailySales as decimal? ?? 0;
    var pendingOrders = ViewBag.PendingOrders as int? ?? 0;
    var monthlyRevenue = ViewBag.MonthlyRevenue as decimal? ?? 0;
    var monthlyOrders = ViewBag.MonthlyOrders as int? ?? 0;
    var averageOrderValue = ViewBag.AverageOrderValue as decimal? ?? 0;
    var lowStockProducts = ViewBag.LowStockProducts as IEnumerable<(string ProductName, int StockQuantity)> ?? new List<(string, int)>();
}

<div class="container mt-4">
    <h2 class="mb-4">
        <i class="bi bi-speedometer2"></i> @store?.StoreName Dashboard
    </h2>

    <!-- Key Metrics -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Today's Sales</h5>
                    <h2 class="mb-0">₹@dailySales.ToString("N0")</h2>
                    <small>Current day</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title">Pending Orders</h5>
                    <h2 class="mb-0">@pendingOrders</h2>
                    <small>
                        <a asp-controller="StoreOrder" asp-action="Index" asp-route-status="Pending" class="text-white">
                            View orders <i class="bi bi-arrow-right"></i>
                        </a>
                    </small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Monthly Revenue</h5>
                    <h2 class="mb-0">₹@monthlyRevenue.ToString("N0")</h2>
                    <small>@monthlyOrders orders</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title">Avg Order Value</h5>
                    <h2 class="mb-0">₹@averageOrderValue.ToString("N0")</h2>
                    <small>This month</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Store Information -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-shop"></i> Store Information
                    </h5>
                </div>
                <div class="card-body">
                    @if (store != null)
                    {
                        <div class="mb-3">
                            <strong>Store Name:</strong> @store.StoreName
                        </div>
                        <div class="mb-3">
                            <strong>Status:</strong>
                            <span class="badge bg-@(store.Status == CleanMvcApp.Models.Enums.StoreStatus.Approved ? "success" : "warning")">
                                @store.Status
                            </span>
                        </div>
                        <div class="mb-3">
                            <strong>Average Rating:</strong>
                            <span class="text-warning">
                                @for (int i = 0; i < (int)store.AverageRating; i++)
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                @for (int i = (int)store.AverageRating; i < 5; i++)
                                {
                                    <i class="bi bi-star"></i>
                                }
                            </span>
                            (@store.AverageRating.ToString("F1"))
                        </div>
                        <div class="mb-3">
                            <strong>Delivery Charge:</strong> ₹@store.DeliveryCharge
                        </div>
                        <div class="d-grid gap-2">
                            <a asp-controller="Store" asp-action="Edit" asp-route-id="@store.StoreId" class="btn btn-outline-primary">
                                <i class="bi bi-pencil"></i> Edit Store
                            </a>
                            <a asp-controller="Review" asp-action="StoreReviews" asp-route-id="@store.StoreId" class="btn btn-outline-info">
                                <i class="bi bi-star"></i> View Reviews
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Low Stock Alerts -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-exclamation-triangle"></i> Low Stock Alerts
                    </h5>
                </div>
                <div class="card-body">
                    @if (lowStockProducts.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Stock</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in lowStockProducts)
                                    {
                                        <tr>
                                            <td>@product.ProductName</td>
                                            <td>
                                                <span class="badge bg-@(product.StockQuantity == 0 ? "danger" : "warning")">
                                                    @product.StockQuantity
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="d-grid">
                            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-warning">
                                <i class="bi bi-box"></i> Manage Products
                            </a>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center mb-0">All products are well stocked!</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-lightning"></i> Quick Actions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-2">
                            <a asp-controller="StoreOrder" asp-action="Index" class="btn btn-outline-primary w-100">
                                <i class="bi bi-bag"></i> View Orders
                            </a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-info w-100">
                                <i class="bi bi-box"></i> Manage Products
                            </a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a asp-controller="Product" asp-action="Create" class="btn btn-outline-success w-100">
                                <i class="bi bi-plus-circle"></i> Add Product
                            </a>
                        </div>
                        <div class="col-md-3 mb-2">
                            <a asp-controller="Store" asp-action="Details" asp-route-id="@store?.StoreId" class="btn btn-outline-secondary w-100">
                                <i class="bi bi-info-circle"></i> Store Details
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
