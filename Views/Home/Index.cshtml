@model IEnumerable<CleanMvcApp.Models.Entities.Store>

@{
    ViewData["Title"] = "Home";
}

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="display-4">Welcome to Local Store Platform</h1>
        <p class="lead">Discover local stores and shop from your favorite merchants</p>
    </div>

    <!-- Search Bar -->
    <div class="row mb-4">
        <div class="col-md-8 offset-md-2">
            <form asp-controller="Browse" asp-action="Search" method="get">
                <div class="input-group input-group-lg">
                    <input type="text" name="searchTerm" class="form-control" placeholder="Search for products...">
                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-search"></i> Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Stores Section -->
    <div class="row">
        <div class="col-12">
            <h2 class="mb-4">Available Stores</h2>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var store in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(store.StoreImageUrl))
                        {
                            <img src="@store.StoreImageUrl" class="card-img-top" alt="@store.StoreName" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="bi bi-shop" style="font-size: 4rem; color: white;"></i>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@store.StoreName</h5>
                            <p class="card-text text-muted">
                                <i class="bi bi-geo-alt"></i> @store.Address
                            </p>
                            <div class="mb-2">
                                <span class="badge bg-info">
                                    <i class="bi bi-clock"></i> @store.OpeningTime.ToString(@"hh\:mm") - @store.ClosingTime.ToString(@"hh\:mm")
                                </span>
                            </div>
                            <div class="mb-2">
                                @if (store.AverageRating > 0)
                                {
                                    <span class="text-warning">
                                        @for (int i = 0; i < (int)store.AverageRating; i++)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        @for (int i = (int)store.AverageRating; i < 5; i++)
                                        {
                                            <i class="bi bi-star"></i>
                                        }
                                    </span>
                                    <span class="text-muted">(@store.TotalReviews reviews)</span>
                                }
                                else
                                {
                                    <span class="text-muted">No reviews yet</span>
                                }
                            </div>
                            <p class="card-text">
                                <small class="text-muted">Delivery: ₹@store.DeliveryCharge</small>
                            </p>
                        </div>
                        <div class="card-footer bg-white">
                            <a asp-controller="Browse" asp-action="Products" asp-route-storeId="@store.StoreId" class="btn btn-primary w-100">
                                <i class="bi bi-bag"></i> Browse Products
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            <h4>No stores available yet</h4>
            <p>Check back soon for local stores in your area!</p>
        </div>
    }
</div>
