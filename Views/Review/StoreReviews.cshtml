@model IEnumerable<CleanMvcApp.Models.Entities.Review>

@{
    ViewData["Title"] = "Store Reviews";
    var store = ViewBag.Store as CleanMvcApp.Models.Entities.Store;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="bi bi-star"></i> Reviews for @store?.StoreName
        </h2>
        <a asp-controller="Browse" asp-action="Products" asp-route-storeId="@store?.StoreId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Store
        </a>
    </div>

    @if (store != null)
    {
        <div class="card mb-4">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-3 text-center">
                        <h1 class="display-4 mb-0">@store.AverageRating.ToString("F1")</h1>
                        <div class="text-warning">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= (int)Math.Floor((double)store.AverageRating))
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                else if (i - 0.5 <= (double)store.AverageRating)
                                {
                                    <i class="bi bi-star-half"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star"></i>
                                }
                            }
                        </div>
                        <p class="text-muted">@Model.Count() reviews</p>
                    </div>
                    <div class="col-md-9">
                        <h5>@store.StoreName</h5>
                        <p class="text-muted mb-0">@store.Address</p>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var review in Model)
            {
                <div class="col-md-12 mb-3">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="text-warning mb-2">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= review.Rating)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star"></i>
                                            }
                                        }
                                    </div>
                                    <p class="mb-2">@review.Comment</p>
                                    <small class="text-muted">
                                        By @review.Customer?.Email on @review.CreatedAt.ToString("MMM dd, yyyy")
                                    </small>
                                </div>
                                @if (User.IsInRole("Admin"))
                                {
                                    <form asp-controller="AdminReview" asp-action="Delete" asp-route-id="@review.ReviewId" method="post" 
                                          onsubmit="return confirm('Are you sure you want to delete this review?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-chat-left-text" style="font-size: 5rem; color: #ccc;"></i>
            <h3 class="mt-3">No reviews yet</h3>
            <p class="text-muted">Be the first to review this store!</p>
        </div>
    }
</div>
