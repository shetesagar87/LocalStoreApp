@model CleanMvcApp.Models.Entities.Store
@{
    ViewData["Title"] = "Store Details";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@Model.StoreName</h2>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.StoreId" class="btn btn-secondary">Edit</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-4">
            @if (!string.IsNullOrEmpty(Model.StoreImageUrl))
            {
                <img src="@Model.StoreImageUrl" class="img-fluid rounded" alt="@Model.StoreName">
            }
            else
            {
                <div class="bg-secondary text-white d-flex align-items-center justify-content-center rounded" style="height: 300px;">
                    <span>No Image</span>
                </div>
            }
        </div>
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Store Information</h5>
                    <table class="table">
                        <tr>
                            <th>Status:</th>
                            <td>
                                <span class="badge @(Model.Status == CleanMvcApp.Models.Enums.StoreStatus.Approved ? "bg-success" : Model.Status == CleanMvcApp.Models.Enums.StoreStatus.Pending ? "bg-warning" : "bg-danger")">
                                    @Model.Status
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <th>Active:</th>
                            <td>
                                <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                                    @(Model.IsActive ? "Active" : "Inactive")
                                </span>
                                @if (Model.Status == CleanMvcApp.Models.Enums.StoreStatus.Approved)
                                {
                                    <form asp-action="ToggleStatus" asp-route-id="@Model.StoreId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-primary">
                                            @(Model.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Address:</th>
                            <td>@Model.Address</td>
                        </tr>
                        <tr>
                            <th>Location:</th>
                            <td>@Model.Latitude, @Model.Longitude</td>
                        </tr>
                        <tr>
                            <th>License Number:</th>
                            <td>@Model.LicenseNumber</td>
                        </tr>
                        <tr>
                            <th>Delivery Radius:</th>
                            <td>@Model.DeliveryRadius km</td>
                        </tr>
                        <tr>
                            <th>Delivery Charge:</th>
                            <td>$@Model.DeliveryCharge</td>
                        </tr>
                        <tr>
                            <th>Average Rating:</th>
                            <td>@Model.AverageRating ⭐ (@Model.TotalReviews reviews)</td>
                        </tr>
                        <tr>
                            <th>Created:</th>
                            <td>@Model.CreatedAt.ToString("MMM dd, yyyy")</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
